<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31 이상의 backup·기기 이전 규칙.
  auth_session.pb는 cloud backup과 기기 간 이전 모두에서 제외한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="auth_session.pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="auth_session.pb" />
    </device-transfer>
</data-extraction-rules>
