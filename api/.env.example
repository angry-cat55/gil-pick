# 데이터베이스
DATABASE_URL=postgresql+asyncpg://gilpick:change-me-local-only@localhost:5432/gilpick

# Docker Compose용 PostgreSQL 설정
POSTGRES_DB=gilpick
POSTGRES_USER=gilpick
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# 기존 애플리케이션 필수 설정
JWT_SIGNING_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=https://api.gilpick.example
JWT_AUDIENCE=gilpick-android

# F008 여행 변수 감지 외부 데이터(선택)
KMA_SERVICE_KEY=
SEOUL_CITYDATA_API_KEY=

# 카카오 인증
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_REDIRECT_URI=https://api.gilpick.example/api/v1/auth/kakao/callback

# Android App Link
ANDROID_APP_LINK_BASE_URL=https://app.gilpick.example/auth/kakao/complete
ANDROID_APP_LINK_HOST=app.gilpick.example

# 관광·장소 검색
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=replace-with-tour-api-service-key
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
PLACE_PROVIDER_TIMEOUT_SECONDS=5

# F005 경로 계산
TMAP_BASE_URL=https://apis.openapi.sk.com
TMAP_API_KEY=replace-with-tmap-api-key
ODSAY_BASE_URL=https://api.odsay.com/v1/api
ODSAY_API_KEY=replace-with-odsay-server-api-key
ROUTE_PROVIDER_TIMEOUT_SECONDS=5
ROUTE_CALCULATION_DEADLINE_SECONDS=10
ROUTE_PROVIDER_CONCURRENCY=3

# F011 알림(FCM 자격 정보가 없으면 비활성 유지)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_REQUEST_TIMEOUT_SECONDS=5
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30
NOTIFICATION_CLEANUP_INTERVAL_SECONDS=3600
